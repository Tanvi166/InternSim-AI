# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM Providers
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# GitHub Integration (Milestone 1)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_TOKEN_ENCRYPTION_KEY=your-32-byte-aes-gcm-encryption-key

# Code execution service base URL. The public Piston API now requires authorization.
# For a self-hosted Piston instance, use its /api/v2 base (for example: http://piston:2000/api/v2).
# PISTON_API_URL=https://emkc.org/api/v2/piston
# PISTON_API_URL=http://piston:2000/api/v2

# Project Runtime Manager (separate from Piston)
# Install backend dependency `docker` and configure a Docker daemon before enabling.
PROJECT_RUNTIME_PYTHON_IMAGE=python:3.12-slim
PROJECT_RUNTIME_NODE_IMAGE=node:22-alpine
PROJECT_RUNTIME_MEMORY_LIMIT=512m
PROJECT_RUNTIME_CPU_LIMIT=1
PROJECT_RUNTIME_PROCESS_LIMIT=128
PROJECT_RUNTIME_TIMEOUT_SECONDS=1800
PROJECT_RUNTIME_MAX_FILES=200
PROJECT_RUNTIME_MAX_BYTES=10000000
# Safe default disables installer networking. Use "proxy" only after deploying
# an operator-managed egress proxy with an allowlist for approved package registries.
PROJECT_RUNTIME_INSTALL_NETWORK=none
# Required when PROJECT_RUNTIME_INSTALL_NETWORK=proxy. The proxy container must be running and
# labeled internsim.role=restricted-egress-proxy. Do not publish its port to the host.
PROJECT_RUNTIME_INSTALL_PROXY_CONTAINER=
PROJECT_RUNTIME_INSTALL_PROXY_URL=http://internsim-install-proxy:3128
# Browser-reachable backend origin; preview requires the authenticated cookie minted by the API.
PROJECT_RUNTIME_PREVIEW_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Set to the loopback address reachable by the backend from the Docker host (often host.docker.internal when backend is containerized).
PROJECT_RUNTIME_PREVIEW_PROXY_HOST=127.0.0.1
# Match these IDs to the backend process so the isolated temporary workspace is writable.
# PROJECT_RUNTIME_CONTAINER_UID=1000
# PROJECT_RUNTIME_CONTAINER_GID=1000
